{
	"name": "shop",
	"version": "0.1.0",
	"description": "ZironTap Shop: the ecommerce frontend for ZironTap. Manages product listings, checkout, and order management for templates, themes, and media.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev -p 3001",
		"build": "next build",
		"start": "next start -p 3001",
